# Oracle Sentinel AI - Environment Configuration
# Copy this file to .env and fill in the values

# Application
APP_NAME=Oracle Sentinel AI
APP_VERSION=0.1.0
DEBUG=false
SECRET_KEY=change-me-in-production

# PostgreSQL
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/sentinel
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# Oracle
# ---------------------------------------------------------------------------
# Storing the GSYSTEM password encrypted in .env:
#
#   1. Generate a Fernet encryption key:
#      python scripts/encrypt-secret.py key
#      → Copy the output and set it as SECRET_KEY below
#
#   2. Encrypt your GSYSTEM password:
#      python scripts/encrypt-secret.py encrypt "YourActualPassword"
#      → Copy the output (starts with gAAAAA) and set it as ORACLE_PASSWORD below
#
#   3. The app automatically decrypts ORACLE_PASSWORD at runtime.
#      You can also leave it as plain-text during development — the resolver
#      handles both encrypted and plain-text values transparently.
# ---------------------------------------------------------------------------
TNS_ADMIN=./tns
ORACLE_USERNAME=GSYSTEM
ORACLE_PASSWORD=
# Optional reference to an environment variable, e.g. env:SENTINEL_ORACLE_PASSWORD
ORACLE_PASSWORD_SECRET_REF=
ORACLE_CONNECTION_TIMEOUT=30
ORACLE_STATEMENT_TIMEOUT=60

# Redis
REDIS_URL=redis://localhost:6379/0

# AI / LLM
AI_ENABLED=false
AI_PROVIDER=disabled
AI_LOCAL_URL=http://localhost:11434
AI_HOSTED_API_KEY_SECRET_REF=
AI_MODEL_NAME=llama3
AI_TIMEOUT_SECONDS=30

# SMTP Notifications
# Portal alerts are always enabled. Email delivery is opt-in.
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD_SECRET_REF=
SMTP_USE_TLS=true
SMTP_FROM_ADDRESS=
NOTIFICATION_RECIPIENTS=[]
NOTIFICATION_MAX_RETRIES=3
NOTIFICATION_RETRY_BACKOFF_SECONDS=5

# Scheduler
SCHEDULER_ENABLED=false
SCHEDULER_DEFAULT_INTERVAL_SECONDS=300
SCHEDULER_WORKERS=4
SCHEDULER_RECONCILE_SECONDS=30
COLLECTOR_LEASE_SECONDS=1800
OBSERVATION_RETENTION_DAYS=30
SYNTHETIC_MODE=false
# Optional JSON overrides; all six probe names are required when overriding global maps.
POLL_INTERVALS={"connectivity":60,"instance":300,"storage":300,"fra_archive":180,"resources":180,"configuration":1800}
STALE_AFTER_SECONDS={"connectivity":180,"instance":900,"storage":900,"fra_archive":540,"resources":540,"configuration":5400}

# Knowledge
KNOWLEDGE_INTAKE_PATH=./knowledge-intake
KNOWLEDGE_ENABLED=false

# Logging
LOG_LEVEL=INFO

# CORS
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]
