# Oracle Sentinel AI - Environment Configuration
# Copy this file to .env and fill in the values

# Application
APP_NAME=Oracle Sentinel AI
APP_VERSION=0.1.0
# dev or test lets the sentinel admin choose a model. production hides that choice.
APP_ENV=dev
DEBUG=false
SECRET_KEY=change-me-in-production

# PostgreSQL
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/sentinel
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# Oracle
# ---------------------------------------------------------------------------
# Storing the GSYSTEM password encrypted in .env:
#
#   1. Generate a Fernet encryption key:
#      python scripts/encrypt-secret.py key
#      → Copy the output and set it as SECRET_KEY below
#
#   2. Encrypt your GSYSTEM password:
#      python scripts/encrypt-secret.py encrypt "YourActualPassword"
#      → Copy the output (starts with gAAAAA) and set it as ORACLE_PASSWORD below
#
#   3. The app automatically decrypts ORACLE_PASSWORD at runtime.
#      You can also leave it as plain-text during development — the resolver
#      handles both encrypted and plain-text values transparently.
# ---------------------------------------------------------------------------
TNS_ADMIN=./tns
ORACLE_USERNAME=GSYSTEM
ORACLE_PASSWORD=
# Optional reference to an environment variable, e.g. env:SENTINEL_ORACLE_PASSWORD
ORACLE_PASSWORD_SECRET_REF=
ORACLE_CONNECTION_TIMEOUT=30
ORACLE_STATEMENT_TIMEOUT=60

# Redis
REDIS_URL=redis://localhost:6379/0

# AI / LLM
# Monitoring keeps running when AI is disabled. AI_FALLBACK_PROVIDER must stay disabled:
# a local outage must not send prompts to a hosted model.
# A hosted model is used only when AI_PROVIDER=hosted and approval, model, secret reference,
# and privacy disclosure are all set. AI_HOSTED_VENDOR is openai or anthropic.
# An empty AI_HOSTED_API_BASE uses https://api.openai.com/v1 or https://api.anthropic.com.
# Point AI_HOSTED_API_KEY_SECRET_REF at the variable that holds the key, for example
# secret://OPENAI_API_KEY. Put the key itself on OPENAI_API_KEY or ANTHROPIC_API_KEY.
# Do not put the key in AI_HOSTED_API_KEY_SECRET_REF. Leave AI_FALLBACK_PROVIDER=disabled.
# Example switch to OpenAI, with the key left blank here:
# AI_ENABLED=true
# AI_PROVIDER=hosted
# AI_HOSTED_APPROVED=true
# AI_HOSTED_VENDOR=openai
# AI_HOSTED_MODEL=gpt-4o-mini
# AI_HOSTED_API_KEY_SECRET_REF=secret://OPENAI_API_KEY
# AI_HOSTED_PRIVACY_DISCLOSURE=Questions and redacted evidence are sent to OpenAI.
# For Anthropic, use AI_HOSTED_VENDOR=anthropic, a Claude model name,
# AI_HOSTED_API_KEY_SECRET_REF=secret://ANTHROPIC_API_KEY, and ANTHROPIC_API_KEY.
# AI_HOSTED_* is the configured default, used when the portal stays on Configured default.
# In dev or test the sentinel admin can pick local, Claude, or OpenAI. Each choice
# uses only its own block below. A timeout or output limit of 0 uses AI_TIMEOUT_SECONDS
# or AI_MAX_OUTPUT_TOKENS. Put key values on ANTHROPIC_API_KEY, OPENAI_API_KEY, or
# LOCAL_AI_API_KEY. Leave the local key reference empty when the local endpoint needs no key.
AI_ENABLED=false
AI_PROVIDER=disabled
AI_FALLBACK_PROVIDER=disabled
AI_LOCAL_URL=http://localhost:11434
AI_MODEL_NAME=llama3
AI_TIMEOUT_SECONDS=30
AI_MAX_TOOL_CALLS=5
AI_MAX_OUTPUT_TOKENS=600
AI_MAX_CONTEXT_TOKENS=12000
AI_REQUIRE_CITATIONS=true
AI_REDACT_SENSITIVE_TELEMETRY=true
AI_HOSTED_APPROVED=false
AI_HOSTED_VENDOR=openai
AI_HOSTED_API_BASE=
AI_HOSTED_MODEL=
AI_HOSTED_API_KEY_SECRET_REF=
AI_HOSTED_PRIVACY_DISCLOSURE=
# Portal choice: local model. AI_LOCAL_URL is the base URL. AI_LOCAL_MODEL overrides AI_MODEL_NAME.
AI_LOCAL_MODEL=
AI_LOCAL_API_KEY_SECRET_REF=
AI_LOCAL_PRIVACY_DISCLOSURE=
AI_LOCAL_TIMEOUT_SECONDS=0
AI_LOCAL_MAX_OUTPUT_TOKENS=0
# Portal choice: Anthropic. Empty model, base, key reference, or disclosure keeps the configured AI_HOSTED_* Claude values.
AI_ANTHROPIC_MODEL=
AI_ANTHROPIC_API_BASE=
AI_ANTHROPIC_API_KEY_SECRET_REF=secret://ANTHROPIC_API_KEY
AI_ANTHROPIC_PRIVACY_DISCLOSURE=Questions and redacted evidence are sent to Anthropic.
AI_ANTHROPIC_TIMEOUT_SECONDS=0
AI_ANTHROPIC_MAX_OUTPUT_TOKENS=0
# Portal choice: OpenAI. An empty base uses https://api.openai.com/v1. Leave the key empty until you add it.
AI_OPENAI_MODEL=gpt-4o
AI_OPENAI_API_BASE=
AI_OPENAI_API_KEY_SECRET_REF=secret://OPENAI_API_KEY
AI_OPENAI_PRIVACY_DISCLOSURE=Questions and redacted evidence are sent to OpenAI.
AI_OPENAI_TIMEOUT_SECONDS=0
AI_OPENAI_MAX_OUTPUT_TOKENS=0
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LOCAL_AI_API_KEY=

# SMTP Notifications
# Portal alerts are always enabled. Email delivery is opt-in.
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD_SECRET_REF=
SMTP_USE_TLS=true
SMTP_FROM_ADDRESS=
NOTIFICATION_RECIPIENTS=[]
NOTIFICATION_MAX_RETRIES=3
NOTIFICATION_RETRY_BACKOFF_SECONDS=5

# Scheduler
SCHEDULER_ENABLED=false
SCHEDULER_DEFAULT_INTERVAL_SECONDS=300
SCHEDULER_WORKERS=4
SCHEDULER_RECONCILE_SECONDS=30
COLLECTOR_LEASE_SECONDS=1800
OBSERVATION_RETENTION_DAYS=30
SYNTHETIC_MODE=false
# Optional JSON overrides; all six probe names are required when overriding global maps.
POLL_INTERVALS={"connectivity":60,"instance":300,"storage":300,"fra_archive":180,"resources":180,"configuration":1800}
STALE_AFTER_SECONDS={"connectivity":180,"instance":900,"storage":900,"fra_archive":540,"resources":540,"configuration":5400}

# Knowledge
# Scheduled scans run when KNOWLEDGE_ENABLED=true. Search and manual reindex work either way.
# Embeddings stay on this machine unless remote embeddings are explicitly approved.
KNOWLEDGE_INTAKE_PATH=./knowledge-intake
KNOWLEDGE_ENABLED=false
KNOWLEDGE_SCAN_INTERVAL_SECONDS=300
KNOWLEDGE_MAX_FILE_BYTES=20971520
KNOWLEDGE_MAX_PAGES=800
KNOWLEDGE_PARSER_TIMEOUT_SECONDS=30
KNOWLEDGE_MIN_EXTRACTED_CHARS=20
KNOWLEDGE_CHUNK_SIZE=800
KNOWLEDGE_CHUNK_OVERLAP=120
KNOWLEDGE_MALWARE_SCANNER=
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=local-hashing-v1
EMBEDDING_DIMENSIONS=128
EMBEDDING_REMOTE_URL=
EMBEDDING_REMOTE_APPROVED=false
EMBEDDING_REMOTE_PRIVACY_DISCLOSURE=

# Logging
LOG_LEVEL=INFO

# CORS
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]

# Sign-in. Leave AUTH_REQUIRED=false for a private development API.
# When it is true, Active Directory is used if AUTH_AD_URL is set and reachable.
# A local account is used when the directory is not configured or cannot be reached.
AUTH_REQUIRED=false
AUTH_SESSION_HOURS=8
AUTH_COOKIE_SECURE=false
AUTH_BOOTSTRAP_USERNAME=
AUTH_BOOTSTRAP_PASSWORD=
AUTH_BOOTSTRAP_ROLE=admin
AUTH_AD_URL=
AUTH_AD_DOMAIN=
AUTH_AD_BASE_DN=
AUTH_AD_OPERATOR_GROUP=
AUTH_AD_DBA_GROUP=
AUTH_AD_ADMIN_GROUP=

# Optional enterprise OIDC. Leave the issuer empty to keep local and Active Directory sign-in only.
# The client secret belongs on OIDC_CLIENT_SECRET, referenced below. Do not put the secret in this field.
AUTH_OIDC_ISSUER=
AUTH_OIDC_CLIENT_ID=
AUTH_OIDC_CLIENT_SECRET_REF=secret://OIDC_CLIENT_SECRET
AUTH_OIDC_REDIRECT_URI=http://127.0.0.1:8000/api/v1/auth/oidc/callback
AUTH_OIDC_SUCCESS_URL=http://127.0.0.1:5173/
PROPOSAL_EXPIRY_HOURS=24
# Privileged execution stays off. Enabling the first flag without the second is rejected.
# Both flags still do not send a statement to Oracle in Release 1.
OPERATIONS_EXECUTION_ENABLED=false
OPERATIONS_EXECUTION_APPROVED=false
OPERATIONS_REQUIRE_DUAL_APPROVAL=true
LOG_JSON=false
